{
	"name": "reviews-web",
	"version": "2.0.0-b.3",
	"description": "A Discord bot written on top of discord.js for gathering reviews.",
	"main": "dist/index.js",
	"imports": {
		"#util/*": [
			"./dist/lib/utils/*.js"
		],
		"#structure/*": [
			"./dist/lib/structures/*.js"
		],
		"#manager/*": [
			"./dist/lib/manager/*.js"
		],
		"#lib/*": [
			"./dist/lib/*.js"
		],
		"#model/*": [
			"./dist/models/*.js"
		],
		"#types/*": [
			"./dist/types/*.js"
		],
		"#commands/*": [
			"./dist/commands/*.js"
		],
		"#root/*": [
			"./dist/*.js"
		],
		"#controller/*": [
			"./dist/controller/*.js"
		]
	},
	"scripts": {
		"dev:esbuild": "tsup --watch --onSuccess \"pnpm start\"",
		"dev": "pnpm build && concurrently --kill-others-on-fail \"swc src --out-dir dist --strip-leading-paths --watch\" \"nodemon --enable-source-maps . --watch\"",
		"build": "swc src --out-dir dist --strip-leading-paths",
		"start": "node --enable-source-maps ./dist/index.js",
		"lint": "eslint --fix --cache .",
		"format": "prettier --write --cache .",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"test": "vitest run"
	},
	"author": "Fraimer De La Cruz",
	"license": "MIT",
	"dependencies": {
		"@imranbarbhuiya/decancer": "^0.2.4",
		"@imranbarbhuiya/duration": "^5.1.8",
		"@sapphire/shapeshift": "^3.9.6",
		"@skyra/env-utilities": "^1.3.0",
		"@skyra/jaro-winkler": "^1.1.1",
		"@swc/helpers": "^0.5.6",
		"@types/cors": "^2.8.17",
		"axios": "^1.7.7",
		"captcha.gif": "^1.0.11",
		"colorette": "^2.0.20",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"diff": "^5.2.0",
		"discord-hybrid-sharding": "^2.2.0",
		"discord.js": "^14.14.1",
		"express": "^4.19.2",
		"figlet": "^1.7.0",
		"gradient-string": "^2.0.2",
		"he": "^1.2.0",
		"highlight.js": "^11.9.0",
		"jsdom": "^24.0.0",
		"jsonwebtoken": "^9.0.2",
		"mathjs": "^12.4.0",
		"mongoose": "8.2.0",
		"pagination.djs": "^4.0.14",
		"pidusage": "^3.0.2",
		"re2": "^1.20.9",
		"safe-regex": "^2.1.1",
		"tagscript": "^1.3.2",
		"tagscript-plugin-discord": "^2.1.2",
		"twemoji-parser": "^14.0.0",
		"undici": "^6.19.2",
		"zlib-sync": "^0.1.9"
	},
	"devDependencies": {
		"@swc-node/register": "^1.8.0",
		"@swc/cli": "^0.3.10",
		"@swc/core": "^1.4.2",
		"@types/cookie-parser": "^1.4.7",
		"@types/diff": "^5.0.9",
		"@types/express": "^4.17.21",
		"@types/figlet": "^1.5.8",
		"@types/gradient-string": "^1.1.5",
		"@types/he": "^1.2.3",
		"@types/jsdom": "^21.1.6",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^20.11.23",
		"@types/safe-regex": "^1.1.6",
		"bufferutil": "^4.0.8",
		"chokidar": "^3.6.0",
		"concurrently": "^8.2.2",
		"eslint": "^9.17.0",
		"eslint-config-mahir": "^0.0.43",
		"nodemon": "^3.1.9",
		"prettier": "^3.2.5",
		"tsup": "^8.0.2",
		"typescript": "^5.3.3",
		"utf-8-validate": "^6.0.3",
		"vitest": "^1.3.1"
	},
	"keywords": [
		"discord",
		"bot",
		"moderation",
		"music",
		"bot"
	]
}
